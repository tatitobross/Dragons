rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /profile-images/{userId}/{fileName} { allow read: if true; allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    match /gallery/{fileName} { allow read: if true; allow write: if isAdmin() && request.resource.size < 25 * 1024 * 1024; }
  }
}
